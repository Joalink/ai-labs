{
	"name": "portafolio-ai-workspace",
	"dockerComposeFile": "docker-compose.yml",
	"service": "workspace",
	"workspaceFolder": "/workspace",
	"forwardPorts": [3000,8000,5432],
	"portsAttributes": {
		"3000": {
			"label": "Next.js Dev",
			"onAutoForward": "notify"
		}
	},
	"postCreateCommand": "bash .devcontainer/scripts/setup.sh",
	"mounts": ["source=${env:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind" ],
	"remoteUser": "vscode",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"bradlc.vscode-tailwindcss",
				"42crunch.vscode-openapi",
				"humao.rest-client",
				"eamodio.gitlens",
				"github.vscode-github-actions",
				"ms-azuretools.vscode-docker",
				"streetsidesoftware.code-spell-checker",
				"mikestead.dotenv",
				"yzhang.markdown-all-in-one",
				"EditorConfig.EditorConfig",
				"johnpapa.vscode-peacock"
			],

			"settings": {
				"python.defaultInterpreterPath": "/workspace/apps/api/.venv/bin/python",
				"python.formatting.provider": "none",
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": {
						"source.fixAll.ruff": "explicit",
						"source.organizeImports.ruff": "explicit"
					}
				},
				"[typescript]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode",
					"editor.formatOnSave": true
				},
				"workbench.colorCustomizations": {
					"titleBar.activeBackground": "#0070F3",
					"titleBar.activeForeground": "#FFFFFF",
					"activityBar.background": "#0070F3",
					"activityBar.foreground": "#FFFFFF",
					"statusBar.background": "#0070F3",
					"statusBar.foreground": "#FFFFFF"
				},
				"editor.tabSize": 2,
				"editor.rulers": [88, 120],
				"editor.bracketPairColorization.enabled": true,
				"files.exclude": {
					"**/__pycache__": true,
					"**/.pytest_cache": true,
					"**/node_modules": true,
					"**/.next": true,
					"**/*.pyc": true
				},
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	}
}
